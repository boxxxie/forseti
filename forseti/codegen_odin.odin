package forseti

import "core:fmt"
import "core:mem"
import "core:strings"

@(private)
odin_type_for_ref :: proc "contextless" (t: Type_Ref) -> string {
	switch t.kind {
	case .Bool:
		return "bool"
	case .I32:
		return "i32"
	case .I64:
		return "i64"
	case .F64:
		return "f64"
	case .String, .Enum:
		return "string"
	case .Entity:
		return "u64"
	case .Time:
		return "i64"
	case .Unknown, .Fact, .Table_Result:
		return "i64"
	}
	return "i64"
}

@(private)
write_pascal_ident :: proc(b: ^strings.Builder, raw: string) {
	cap_next := true
	for i := 0; i < len(raw); i += 1 {
		ch := raw[i]
		if ch == '_' {
			strings.write_byte(b, '_')
			cap_next = true
			continue
		}
		if cap_next && ch >= 'a' && ch <= 'z' {
			strings.write_byte(b, ch - ('a' - 'A'))
		} else {
			strings.write_byte(b, ch)
		}
		cap_next = false
	}
}

@(private)
write_odin_scalar :: proc(b: ^strings.Builder, ir: ^Rulebase_IR, eid: Expr_Id) {
	if eid == INVALID_EXPR || int(eid) >= len(ir.exprs) {
		strings.write_string(b, "0")
		return
	}
	e := ir.exprs[eid]
	#partial switch e.kind {
	case .Lit_Bool:
		strings.write_string(b, "true" if e.bool_val else "false")
	case .Lit_Int:
		fmt.sbprintf(b, "%d", e.int_val)
	case .Lit_Float:
		fmt.sbprintf(b, "%v", e.float_val)
	case .Lit_String:
		write_json_escaped_string(b, ir_string(ir, e.str_id))
	case .Unary:
		if e.unary_op == .Neg {
			strings.write_byte(b, '-')
			write_odin_scalar(b, ir, e.lhs)
		}
	}
}

@(private)
write_odin_cell_cond :: proc(b: ^strings.Builder, ir: ^Rulebase_IR, col_name: string, eid: Expr_Id, top_level := true) -> bool {
	if eid == INVALID_EXPR || int(eid) >= len(ir.exprs) {
		strings.write_string(b, "true")
		return false
	}
	e := ir.exprs[eid]
	#partial switch e.kind {
	case .Wildcard:
		strings.write_string(b, "true")
		return false
	case .Lit_Bool, .Lit_Int, .Lit_Float, .Lit_String, .Unary:
		if !top_level {
			strings.write_byte(b, '(')
		}
		fmt.sbprintf(b, "in_val.%s == ", col_name)
		write_odin_scalar(b, ir, eid)
		if !top_level {
			strings.write_byte(b, ')')
		}
		return true
	case .Cell_Cmp:
		if !top_level {
			strings.write_byte(b, '(')
		}
		fmt.sbprintf(b, "in_val.%s %s ", col_name, binary_op_str(e.binary_op))
		write_odin_scalar(b, ir, e.rhs)
		if !top_level {
			strings.write_byte(b, ')')
		}
		return true
	case .Range:
		if !top_level {
			strings.write_byte(b, '(')
		}
		fmt.sbprintf(b, "in_val.%s >= ", col_name)
		write_odin_scalar(b, ir, e.lhs)
		cmp := "<=" if e.inclusive else "<"
		fmt.sbprintf(b, " && in_val.%s %s ", col_name, cmp)
		write_odin_scalar(b, ir, e.rhs)
		if !top_level {
			strings.write_byte(b, ')')
		}
		return true
	case .In_List:
		if e.extra_span.count == 0 {
			strings.write_string(b, "false")
			return false
		}
		if !top_level {
			strings.write_byte(b, '(')
		}
		for i in 0 ..< e.extra_span.count {
			if i > 0 {
				strings.write_string(b, " || ")
			}
			fmt.sbprintf(b, "in_val.%s == ", col_name)
			write_odin_scalar(b, ir, ir.extra_exprs[e.extra_span.start + i])
		}
		if !top_level {
			strings.write_byte(b, ')')
		}
		return true
	case .Binary:
		op_str := "&&" if e.binary_op == .And else "||"
		if !top_level {
			strings.write_byte(b, '(')
		}
		l_used := write_odin_cell_cond(b, ir, col_name, e.lhs, false)
		fmt.sbprintf(b, " %s ", op_str)
		r_used := write_odin_cell_cond(b, ir, col_name, e.rhs, false)
		if !top_level {
			strings.write_byte(b, ')')
		}
		return l_used || r_used
	}
	strings.write_string(b, "true")
	return false
}

@(private)
write_odin_row_cond :: proc(b: ^strings.Builder, ir: ^Rulebase_IR, tbl: Table_Def, row: Table_Row_Def) -> bool {
	active_count := 0
	for cell_id, ci in row.cells {
		if ci >= len(tbl.inputs) {
			break
		}
		if ir.exprs[cell_id].kind != .Wildcard {
			active_count += 1
		}
	}
	if active_count == 0 {
		strings.write_string(b, "true")
		return false
	}
	top_level := active_count == 1
	wrote := false
	for cell_id, ci in row.cells {
		if ci >= len(tbl.inputs) {
			break
		}
		if ir.exprs[cell_id].kind == .Wildcard {
			continue
		}
		if wrote {
			strings.write_string(b, " && ")
		}
		col_name := ir_string(ir, tbl.inputs[ci].name)
		_ = write_odin_cell_cond(b, ir, col_name, cell_id, top_level)
		wrote = true
	}
	return true
}

@(require_results)
codegen_odin_module :: proc(
	ir: ^Rulebase_IR,
	pkg_name: string = "generated_tables",
	allocator := context.allocator,
) -> (out: string, err: mem.Allocator_Error) {
	b: strings.Builder
	strings.builder_init(&b, allocator) or_return
	defer if err != nil {
		strings.builder_destroy(&b)
	}

	effective_pkg := pkg_name if len(pkg_name) > 0 else "generated_tables"
	fmt.sbprintf(&b, "// Code generated by forseti. DO NOT EDIT.\npackage %s\n", effective_pkg)

	if ir == nil {
		return strings.to_string(b), nil
	}

	for tbl in ir.tables {
		tname := ir_string(ir, tbl.name)
		tver := ir_string(ir, tbl.version)

		strings.write_byte(&b, '\n')
		// Input struct
		write_pascal_ident(&b, tname)
		strings.write_string(&b, "_Input :: struct {\n")
		for col in tbl.inputs {
			fmt.sbprintf(&b, "\t%s: %s,\n", ir_string(ir, col.name), odin_type_for_ref(col.type))
		}
		strings.write_string(&b, "}\n\n")

		// Output struct
		write_pascal_ident(&b, tname)
		strings.write_string(&b, "_Output :: struct {\n")
		strings.write_string(&b, "\tmatched: bool,\n")
		strings.write_string(&b, "\trow_id: string,\n")
		strings.write_string(&b, "\tmatched_count: u32,\n")
		for col in tbl.outputs {
			cname := ir_string(ir, col.name)
			ctype := odin_type_for_ref(col.type)
			if tbl.hit_policy == .Collect_Count {
				ctype = "i64"
			}
			fmt.sbprintf(&b, "\t%s: %s,\n", cname, ctype)
			fmt.sbprintf(&b, "\t%s_set: bool,\n", cname)
		}
		strings.write_string(&b, "}\n\n")

		// Version & Row IDs metadata
		fmt.sbprintf(&b, "%s_version :: ", tname)
		write_json_escaped_string(&b, tver)
		strings.write_string(&b, "\n\n")

		if len(tbl.rows) > 0 {
			fmt.sbprintf(&b, "@(rodata)\n%s_row_ids := [%d]string", tname, len(tbl.rows))
			strings.write_string(&b, "{\n")
			for row in tbl.rows {
				strings.write_byte(&b, '\t')
				write_json_escaped_string(&b, ir_string(ir, row.id))
				strings.write_string(&b, ",\n")
			}
			strings.write_string(&b, "}\n\n")
		}

		// Proc signature
		fmt.sbprintf(&b, "decide_%s :: proc \"contextless\" (in_val: ", tname)
		write_pascal_ident(&b, tname)
		strings.write_string(&b, "_Input) -> ")
		write_pascal_ident(&b, tname)
		strings.write_string(&b, "_Output {\n")

		if len(tbl.rows) == 0 {
			strings.write_string(&b, "\t_ = in_val\n")
			if tbl.hit_policy == .Collect_Count && len(tbl.outputs) > 0 {
				fmt.sbprintf(&b, "\treturn {{%s_set = true}}\n", ir_string(ir, tbl.outputs[0].name))
			} else {
				strings.write_string(&b, "\treturn {}\n")
			}
			strings.write_string(&b, "}\n")
			continue
		}

		if is_single_hit_policy(tbl.hit_policy) {
			// For Priority, order by first enum output variant if applicable
			eval_order := make([]int, len(tbl.rows), context.temp_allocator)
			for ri in 0 ..< len(tbl.rows) {
				eval_order[ri] = ri
			}
			if tbl.hit_policy == .Priority && len(tbl.outputs) > 0 && tbl.outputs[0].type.kind == .Enum {
				edef := ir.enums[tbl.outputs[0].type.ref_id]
				ranks := make([]int, len(tbl.rows), context.temp_allocator)
				for ri in 0 ..< len(tbl.rows) {
					ranks[ri] = len(edef.variants)
					if sval, sok := extract_string_const(ir, tbl.rows[ri].outputs[0]); sok {
						s := ir_string(ir, sval)
						for v, vi in edef.variants {
							if ir_string(ir, v) == s {
								ranks[ri] = vi
								break
							}
						}
					}
				}
				// Insertion sort preserves relative row order on ties
				for i := 1; i < len(eval_order); i += 1 {
					key := eval_order[i]
					j := i - 1
					for j >= 0 && ranks[eval_order[j]] > ranks[key] {
						eval_order[j + 1] = eval_order[j]
						j -= 1
					}
					eval_order[j + 1] = key
				}
			}

			for ri in eval_order {
				row := tbl.rows[ri]
				strings.write_string(&b, "\tif ")
				_ = write_odin_row_cond(&b, ir, tbl, row)
				strings.write_string(&b, " {\n\t\treturn ")
				write_pascal_ident(&b, tname)
				fmt.sbprintf(&b, "_Output{{\n\t\t\tmatched = true,\n\t\t\trow_id = %s_row_ids[%d],\n\t\t\tmatched_count = 1,\n", tname, ri)
				for out_eid, oi in row.outputs {
					if oi < len(tbl.outputs) && ir.exprs[out_eid].kind != .Wildcard {
						cname := ir_string(ir, tbl.outputs[oi].name)
						fmt.sbprintf(&b, "\t\t\t%s = ", cname)
						write_odin_scalar(&b, ir, out_eid)
						strings.write_string(&b, ",\n")
						fmt.sbprintf(&b, "\t\t\t%s_set = true,\n", cname)
					}
				}
				strings.write_string(&b, "\t\t}\n\t}\n")
			}
			strings.write_string(&b, "\treturn {}\n}\n")
		} else {
			strings.write_string(&b, "\tout: ")
			write_pascal_ident(&b, tname)
			strings.write_string(&b, "_Output\n")
			for row, ri in tbl.rows {
				strings.write_string(&b, "\tif ")
				_ = write_odin_row_cond(&b, ir, tbl, row)
				strings.write_string(&b, " {\n")
				strings.write_string(&b, "\t\tout.matched = true\n")
				strings.write_string(&b, "\t\tout.matched_count += 1\n")

				#partial switch tbl.hit_policy {
				case .Collect:
					strings.write_string(&b, "\t\tif out.matched_count == 1 {\n")
					fmt.sbprintf(&b, "\t\t\tout.row_id = %s_row_ids[%d]\n", tname, ri)
					for out_eid, oi in row.outputs {
						if oi < len(tbl.outputs) && ir.exprs[out_eid].kind != .Wildcard {
							cname := ir_string(ir, tbl.outputs[oi].name)
							fmt.sbprintf(&b, "\t\t\tout.%s = ", cname)
							write_odin_scalar(&b, ir, out_eid)
							strings.write_byte(&b, '\n')
							fmt.sbprintf(&b, "\t\t\tout.%s_set = true\n", cname)
						}
					}
					strings.write_string(&b, "\t\t}\n")
				case .Merge:
					strings.write_string(&b, "\t\tif out.matched_count == 1 {\n")
					fmt.sbprintf(&b, "\t\t\tout.row_id = %s_row_ids[%d]\n", tname, ri)
					strings.write_string(&b, "\t\t}\n")
					for out_eid, oi in row.outputs {
						if oi < len(tbl.outputs) && ir.exprs[out_eid].kind != .Wildcard {
							cname := ir_string(ir, tbl.outputs[oi].name)
							fmt.sbprintf(&b, "\t\tif !out.%s_set {{\n\t\t\tout.%s = ", cname, cname)
							write_odin_scalar(&b, ir, out_eid)
							fmt.sbprintf(&b, "\n\t\t\tout.%s_set = true\n\t\t}\n", cname)
						}
					}
				case .Reverse_Merge:
					fmt.sbprintf(&b, "\t\tout.row_id = %s_row_ids[%d]\n", tname, ri)
					for out_eid, oi in row.outputs {
						if oi < len(tbl.outputs) && ir.exprs[out_eid].kind != .Wildcard {
							cname := ir_string(ir, tbl.outputs[oi].name)
							fmt.sbprintf(&b, "\t\tout.%s = ", cname)
							write_odin_scalar(&b, ir, out_eid)
							fmt.sbprintf(&b, "\n\t\tout.%s_set = true\n", cname)
						}
					}
				case .Collect_Sum:
					if len(tbl.outputs) > 0 && ir.exprs[row.outputs[0]].kind != .Wildcard {
						cname := ir_string(ir, tbl.outputs[0].name)
						fmt.sbprintf(&b, "\t\tout.%s += ", cname)
						write_odin_scalar(&b, ir, row.outputs[0])
						fmt.sbprintf(&b, "\n\t\tout.%s_set = true\n", cname)
					}
				case .Collect_Min:
					if len(tbl.outputs) > 0 && ir.exprs[row.outputs[0]].kind != .Wildcard {
						cname := ir_string(ir, tbl.outputs[0].name)
						fmt.sbprintf(&b, "\t\tif !out.%s_set || ", cname)
						write_odin_scalar(&b, ir, row.outputs[0])
						fmt.sbprintf(&b, " < out.%s {{\n\t\t\tout.%s = ", cname, cname)
						write_odin_scalar(&b, ir, row.outputs[0])
						fmt.sbprintf(&b, "\n\t\t\tout.%s_set = true\n\t\t}\n", cname)
					}
				case .Collect_Max:
					if len(tbl.outputs) > 0 && ir.exprs[row.outputs[0]].kind != .Wildcard {
						cname := ir_string(ir, tbl.outputs[0].name)
						fmt.sbprintf(&b, "\t\tif !out.%s_set || ", cname)
						write_odin_scalar(&b, ir, row.outputs[0])
						fmt.sbprintf(&b, " > out.%s {{\n\t\t\tout.%s = ", cname, cname)
						write_odin_scalar(&b, ir, row.outputs[0])
						fmt.sbprintf(&b, "\n\t\t\tout.%s_set = true\n\t\t}\n", cname)
					}
				case .Collect_Count:
					strings.write_string(&b, "\t\tif out.matched_count == 1 {\n")
					fmt.sbprintf(&b, "\t\t\tout.row_id = %s_row_ids[%d]\n", tname, ri)
					strings.write_string(&b, "\t\t}\n")
				}
				strings.write_string(&b, "\t}\n")
			}
			if tbl.hit_policy == .Collect_Count && len(tbl.outputs) > 0 {
				cname := ir_string(ir, tbl.outputs[0].name)
				fmt.sbprintf(&b, "\tout.%s = i64(out.matched_count)\n", cname)
				fmt.sbprintf(&b, "\tout.%s_set = true\n", cname)
			}
			strings.write_string(&b, "\treturn out\n}\n")
		}
	}

	return strings.to_string(b), nil
}
