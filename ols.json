{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
	"collections": [
		{ "name": "xitdb", "path": "../xitdb/xitdb" },
		{ "name": "hugi", "path": "../hugi/hugi" },
		{ "name": "obench", "path": "../hugi/deps/obench/obench" }
	],
	"enable_format": true,
	"enable_hover": true,
	"enable_snippets": true,
	"enable_checker_only_saved": true,
	"checker_args": "-vet -vet-tabs -strict-style -disallow-do -warnings-as-errors"
}
